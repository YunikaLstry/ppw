PBNv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pencarian dan Penambangan Web","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zkdIxxvWcM"}],"identifier":"pencarian-dan-penambangan-web","label":"Pencarian dan Penambangan Web","html_id":"pencarian-dan-penambangan-web","implicit":true,"key":"akqPCn8BFm"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Penambangan Web (PPW) merupakan mata kuliah di program studi Teknik Informatika Universitas Trunojoyo Madura (UTM) yang berfokus pada teknik ekstraksi, pemrosesan, dan analisis data berskala besar dari internet. Mahasiswa mempelajari cara mengumpulkan data secara otomatis menggunakan metode crawling dan scraping, sekaligus meletakkan dasar text processing untuk mengubah data mentah dari berbagai situs web menjadi struktur data yang siap diolah.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VqSDsS6leF"}],"key":"qgkM9s5KR3"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Pembahasan dilanjutkan dengan penerapan algoritma kecerdasan buatan, seperti Natural Language Processing (NLP), klasifikasi teks, clustering, dan analisis sentimen terhadap data web. Melalui praktikum dan pengerjaan proyek, mahasiswa Teknik Informatika UTM dilatih untuk membangun pipeline pemrosesan data otomatis yang mampu menarik wawasan (insight), tren, dan pengetahuan berharga untuk kebutuhan riset maupun industri.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Uv5ZkTlNQz"}],"key":"B66Q40KfmR"}],"key":"qCHV0xPeuO"}],"key":"doK6jb2r3x"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Crawling data","url":"/crawling","group":"Web Mining"}}},"domain":"http://localhost:3000"}