{"version":3,"kind":"Notebook","sha256":"ba528bdb5f8573a256e9b386488137ed39e823872a15141d7ec55f57a2f9bdc4","slug":"dasar-skipgram","location":"/dasar-skipgram.ipynb","dependencies":[],"frontmatter":{"title":"Dasar Skipgram","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"nwebmining (3.10.6)","language":"python"},"authors":[{"nameParsed":{"literal":"Yunika Lestari","given":"Yunika","family":"Lestari"},"name":"Yunika Lestari","id":"contributors-webmining\\myst-generated-uid-0"}],"github":"https://github.com/YunikaLstry/ppw","exports":[{"format":"ipynb","filename":"dasar-skipgram.ipynb","url":"/ppw/build/dasar-skipgram-d63cfb736b671e531c3b6a6d9cd0c4a4.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Contoh Skipgram","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EXyigsFchZ"}],"identifier":"contoh-skipgram","label":"Contoh Skipgram","html_id":"contoh-skipgram","implicit":true,"key":"MaDA5wDqGI"}],"identifier":"dcb89fd5","html_id":"dcb89fd5","key":"kVwDWHa9LM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from gensim.models import Word2Vec\nimport pandas as pd","key":"lAFHTzEVSk"},{"type":"outputs","id":"KruDjRT-OBA5ZlvQ186YQ","children":[],"key":"sj4xmWsmWH"}],"identifier":"5197ad1c","html_id":"5197ad1c","key":"tATLCrU9w0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Membuat 3 kalimat\nsentences = [\n    \"Kucing tidur di atas sofa\",\n    \"Anak membaca buku di perpustakaan\",\n    \"Mobil merah melaju dengan cepat\"\n]\n\n# 2. Tokenisasi dan lowercase\ntokenized_sentences = [\n    sentence.lower().split()\n    for sentence in sentences\n]\n\nprint(\"Hasil tokenisasi:\")\nprint(\"-\" * 40)\nfor sentence in tokenized_sentences:\n    print(sentence)\n\n# 3. Membuat model Word2Vec\nmodel = Word2Vec(\n    sentences=tokenized_sentences,\n    vector_size=10,\n    window=2,       # konteks 2 kata\n    min_count=1,\n    workers=1,\n    seed=42\n)","key":"rXypDTvfOw"},{"type":"outputs","id":"Wh4lHJOb_6oSOztuRa8l4","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Hasil tokenisasi:\n----------------------------------------\n['kucing', 'tidur', 'di', 'atas', 'sofa']\n['anak', 'membaca', 'buku', 'di', 'perpustakaan']\n['mobil', 'merah', 'melaju', 'dengan', 'cepat']\n"},"children":[],"key":"kkPff9pFp8"}],"key":"qImjwdMV56"}],"identifier":"69b3b2f1","html_id":"69b3b2f1","key":"iAQHucFZPa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 4. Menampilkan seluruh vocabulary\nprint(\"\\n----------------------------------------\")\nprint(\"Vocabulary\")\nprint(\"-\" * 40)\n\nfor i, kata in enumerate(model.wv.index_to_key):\n    print(f\"{i+1}. {kata}\")\n\n# Menampilkan Semua Pasangan Target-Konteks\nwindow = 2\npairs = []\n\nfor sentence in tokenized_sentences:\n    for i, target in enumerate(sentence):\n        # Menentukan batas konteks\n        start = max(0, i - window)\n        end = min(len(sentence), i + window + 1)\n        # Mengambil pasangan target-konteks\n        for j in range(start, end):\n            # Jangan memasangkan kata dengan dirinya sendiri\n            if i != j:\n                context = sentence[j]\n                pairs.append((target, context))","key":"Rfcp2zDZ9w"},{"type":"outputs","id":"lPyAfYRsaFBdelGQQtQSV","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\n----------------------------------------\nVocabulary\n----------------------------------------\n1. di\n2. cepat\n3. dengan\n4. melaju\n5. merah\n6. mobil\n7. perpustakaan\n8. buku\n9. membaca\n10. anak\n11. sofa\n12. atas\n13. tidur\n14. kucing\n"},"children":[],"key":"Jyw4JqsNwu"}],"key":"VlRPm5BTLS"}],"identifier":"a32c5e89","html_id":"a32c5e89","key":"oivaLtHW4B"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Menampilkan Hasil\nprint(\"\\n----------------------------------------\")\nprint(\"Pasangan (Target, Konteks):\")\nprint(\"-\" * 40)\n\nfor target, context in pairs:\n    print(f\"({target}, {context})\")\n\nprint(\"\\nJumlah pasangan:\", len(pairs))","key":"Rb44nFo4H5"},{"type":"outputs","id":"-82MeLxzGgAE9z27jdKGY","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\n----------------------------------------\nPasangan (Target, Konteks):\n----------------------------------------\n(kucing, tidur)\n(kucing, di)\n(tidur, kucing)\n(tidur, di)\n(tidur, atas)\n(di, kucing)\n(di, tidur)\n(di, atas)\n(di, sofa)\n(atas, tidur)\n(atas, di)\n(atas, sofa)\n(sofa, di)\n(sofa, atas)\n(anak, membaca)\n(anak, buku)\n(membaca, anak)\n(membaca, buku)\n(membaca, di)\n(buku, anak)\n(buku, membaca)\n(buku, di)\n(buku, perpustakaan)\n(di, membaca)\n(di, buku)\n(di, perpustakaan)\n(perpustakaan, buku)\n(perpustakaan, di)\n(mobil, merah)\n(mobil, melaju)\n(merah, mobil)\n(merah, melaju)\n(merah, dengan)\n(melaju, mobil)\n(melaju, merah)\n(melaju, dengan)\n(melaju, cepat)\n(dengan, merah)\n(dengan, melaju)\n(dengan, cepat)\n(cepat, melaju)\n(cepat, dengan)\n\nJumlah pasangan: 42\n"},"children":[],"key":"oXXgVRgKTj"}],"key":"qdFnpLt2Q1"}],"identifier":"b2018e9a","html_id":"b2018e9a","key":"kYBsR7EJ1v"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 5. Mengambil semua kata dan vektornya\nkata = model.wv.index_to_key\nvektor = model.wv.vectors\n\nprint(\"\\n----------------------------------------\")\nprint(\"Semua Vektor\")\nprint(\"-\" * 40)\n\nfor i, word in enumerate(kata):\n    print(f\"\\nKata: {word}\")\n    print(f\"Vektor: {vektor[i]}\"