t","value":") dari kolom id dan label (sebagai variabel target ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"F91qTto1dZ"},{"type":"inlineMath","value":"y","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>y</mi></mrow><annotation encoding=\"application/x-tex\">y</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">y</span></span></span></span>","key":"PESLtjj4e5"},{"type":"text","value":").","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"O0QJPLJDcc"}],"key":"gMeXX5HsR5"}],"key":"uFRdfprwGj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\n\n# Load data matriks TF-IDF jika belum ada di memory\nif 'df_tfidf' not in locals():\n    df_tfidf = pd.read_csv('detik_tfidf_matrix.csv')\n\n# 1. Pisahkan Fitur (X) dan Target (y)\nX = df_tfidf.drop(columns=['id', 'label'])\ny = df_tfidf['label']\n\nprint(\"=== PEMISAHAN FITUR DAN LABEL ===\")\nprint(f\"• Dimensi Fitur (X) : {X.shape} ({X.shape[0]} artikel, {X.shape[1]} kata unik)\")\nprint(f\"• Jumlah Label (y)  : {y.shape[0]} data (1 = Sport, 0 = Finance)\")","key":"SvBymrRf34"},{"type":"outputs","id":"f3rA2QGIc5AEWgCMQkMnl","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"=== PEMISAHAN FITUR DAN LABEL ===\n• Dimensi Fitur (X) : (200, 5305) (200 artikel, 5305 kata unik)\n• Jumlah Label (y)  : 200 data (1 = Sport, 0 = Finance)\n"},"children":[],"key":"UoKXmnkHO3"}],"key":"JDC6i2p2Oj"}],"key":"OdxSABPYv9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Analisis Explained Variance Ratio (Menentukan Jumlah Komponen)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Zw8is1OEit"}],"identifier":"analisis-explained-variance-ratio-menentukan-jumlah-komponen","label":"Analisis Explained Variance Ratio (Menentukan Jumlah Komponen)","html_id":"analisis-explained-variance-ratio-menentukan-jumlah-komponen","implicit":true,"key":"MjKUVYUHOS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Melihat berapa banyak informasi (varians) dari ribuan kata unik yang berhasil dipertahankan saat dikompresi menjadi sejumlah komponen PCA.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YICcz9egLX"}],"key":"xHbsbdni7O"}],"key":"BbKmyfJMlp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport numpy as np\nfrom sklearn.decomposition import PCA","key":"os5PARUhx9"},{"type":"outputs","id":"S_HcVOHkz7LsHenSFvRy7","children":[],"key":"TeNQAPcM1D"}],"key":"EocP1GzDng"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Fit PCA dengan seluruh/banyak komponen awal\npca_full = PCA(n_components=50)\npca_full.fit(X)\n\n# 2. Hitung kumulatif varians\ncumulative_variance = np.cumsum(pca_full.explained_variance_ratio_)\n\n# 3. Visualisasi Grafik Cumulative Explained Variance\nplt.figure(figsize=(8, 4))\nplt.plot(range(1, 51), cumulative_variance, marker='o', linestyle='--', color='b')\nplt.axhline(y=0.80, color='r', linestyle=':', label='80% Varians Terjelaskan')\nplt.title('Scree Plot / Cumulative Explained Variance PCA')\nplt.xlabel('Jumlah Principal Component (PC)')\nplt.ylabel('Kumulatif Varians')\nplt.legend()\nplt.grid(True)\nplt.show()\n\nprint(f\"• Varians terjelaskan oleh 2 PC pertama: {cumulative_variance[1]*100:.2f}%\")","key":"pI9EzIrcR3"},{"type":"outputs","id":"fKni4LX9h9Ha4JMPhzmad","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"d0627b0413de0edbc502ab62a064e911","path":"/build/d0627b0413de0edbc502ab62a064e911.png"},"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"WPZ00fiIKn"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"• Varians terjelaskan oleh 2 PC pertama: 7.59%\n"},"children":[],"key":"H23zaLnAob"}],"key":"BdLqXYqxqU"}],"key":"Unup5BmtIG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Aplikasi PCA (Reduksi menjadi 2 Komponen Utama)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"L7NHWl50qB"}],"identifier":"aplikasi-pca-reduksi-menjadi-2-komponen-utama","label":"Aplikasi PCA (Reduksi menjadi 2 Komponen Utama)","html_id":"aplikasi-pca-reduksi-menjadi-2-komponen-utama","implicit":true,"key":"EqqKWxQUbE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Mengompresi ribuan kolom kata unik menjadi 2 Utama (PC1 & PC2) agar dapat dipetakan secara visual dalam koordinat 2D.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"X4cp8oYGQ6"}],"key":"hj32M7N1OD"}],"key":"g65rEWXogP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Inisialisasi PCA (Contoh: mempertahankan 85% varians)\npca_2d = PCA(n_components=0.85, random_state=42)\n\n# 2. Fit & Transform pada data TF-IDF\nX_pca = pca_2d.fit_transform(X)\n\nprint(\"=== HASIL REDUKSI DIMENSI PCA ===\")\nprint(f\"• Dimensi Awal  : {X.shape}\")\nprint(f\"• Dimensi Akhir : {X_pca.shape} ({X_pca.shape[1]} Komponen Utama)\")\nprint(f\"• Total Varians Terjelaskan : {sum(pca_2d.explained_variance_ratio_)*100:.2f}%\")","key":"oGjG7JAoFM"},{"type":"outputs","id":"3JUo-CaZI8McTKOVIfCZb","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"=== HASIL REDUKSI DIMENSI PCA ===\n• Dimensi Awal  : (200, 5305)\n• Dimensi Akhir : (200, 127) (127 Komponen Utama)\n• Total Varians Terjelaskan : 85.28%\n"},"children":[],"key":"VdYeglNn1u"}],"key":"OZPYJB52Gd"}],"key":"mOWMbF0ibP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualisasi Scatter Plot 2D (Sport vs. Finance)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q4P72oPpGh"}],"identifier":"visualisasi-scatter-plot-2d-sport-vs-finance","label":"Visualisasi Scatter Plot 2D (Sport vs. Finance)","html_id":"visualisasi-scatter-plot-2d-sport-vs-finance","implicit":true,"key":"fBSIi81SK1"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Menggambar sebaran data hasil PCA dalam ruang 2D untuk melihat pemisahan kelompok (clustering/separation) antara kategori Sport (1) dan Finance (0).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lYyDw703C2"}],"key":"ZTfCRJr4IA"}],"key":"GKTfe45tPn"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import seaborn as sns","key":"gJp3jk8YCY"},{"type":"outputs","id":"gzeDe1Sm2UeTNBZG2tDhA","children":[],"key":"JowkREFpz4"}],"key":"X9xQl65p34"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Buat DataFrame sementara untuk plotting menggunakan 2 komponen pertama\nX_pca_2d = X_pca[:, :2]\ndf_plot = pd.DataFrame(X_pca_2d, columns=['PC1', 'PC2'])\ndf_plot['label'] = y.map({1: 'Sport (1)', 0: 'Finance (0)'})\n\n# 2. Visualisasi Scatter Plot\nplt.figure(figsize=(9, 6))\nsns.scatterplot(\n    x='PC1', y='PC2', \n    hue='label', \n    data=df_plot, \n    palette={'Sport (1)': 'blue', 'Finance (0)': 'green'},\n    alpha=0.8, s=70\n)\n\nplt.title('Visualisasi Sebaran Berita Detik.com setelah PCA (2D)', fontsize=12)\nplt.xlabel(f'PC1 ({pca_2d.explained_variance_ratio_[0]*100:.2f}% Varians)')\nplt.ylabel(f'PC2 ({pca_2d.explained_variance_ratio_[1]*100:.2f}% Varians)')\nplt.grid(True, linestyle='--', alpha=0.5)\nplt.legend(title='Kategori')\nplt.show()","key":"J6CVh3CysV"},{"type":"outputs","id":"bj4XvwKjPo_E_05zXf8b0","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"3efd181f8cd4288764ad0ec186ed8abf","path":"/build/3efd181f8cd4288764ad0ec186ed8abf.png"},"text/plain":{"content":"<Figure size 900x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Y6EZmsnlba"}],"key":"j6yg6OmtR5"}],"key":"bZiztOY83l"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pembentukan DataFrame & Ekspor Hasil PCA ke CSV","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QXxm381hTs"}],"identifier":"pembentukan-dataframe-ekspor-hasil-pca-ke-csv","label":"Pembentukan DataFrame & Ekspor Hasil PCA ke CSV","html_id":"pembentukan-dataframe-ekspor-hasil-pca-ke-csv","implicit":true,"key":"ggzIfEtUTE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Menyimpan hasil reduksi dimensi PCA ke dalam file CSV sebagai dataset akhir yang siap digunakan untuk pemodelan Machine Learning (seperti Klasifikasi Naive Bayes, SVM, atau K-NN).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lPrOT8bkVX"}],"key":"fcsnI5jH0Y"}],"key":"YvhYkNIQiN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Buat DataFrame PCA dengan seluruh komponen yang mempertahankan 85% varians\npca_columns = [f'PC{i}' for i in range(1, X_pca.shape[1] + 1)]\ndf_pca_result = pd.DataFrame(X_pca, columns=pca_columns)\n\n# 2. Sisipkan kembali kolom id dan label di awal\ndf_pca_result.insert(0, 'label', y)\ndf_pca_result.insert(0, 'id', df_tfidf['id'])\n\nprint(\"=== TABEL HASIL REDUKSI DIMENSI PCA ===\")\ndisplay(df_pca_result.head())\n\n# 3. Simpan ke file CSV\ndf_pca_result.to_csv('detik_pca_results.csv', index=False, encoding='utf-8-sig')\n\nprint(\"\\n✅ Tahap Reduksi Dimensi dengan PCA Selesai!\")\nprint(\"💾 File tersimpan sebagai 'detik_pca_results.csv'\")","key":"KJU37W6v7E"},{"type":"outputs","id":"tdKRmOZ_5Pznq15_OOpPv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"=== TABEL HASIL REDUKSI DIMENSI PCA ===\n"},"children":[],"key":"y71APytwyU"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>id</th>\n      <th>label</th>\n      <th>PC1</th>\n      <th>PC2</th>\n      <th>PC3</th>\n      <th>PC4</th>\n      <th>PC5</th>\n      <th>PC6</th>\n      <th>PC7</th>\n      <th>PC8</th>\n      <th>...</th>\n      <th>PC118</th>\n      <th>PC119</th>\n      <th>PC120</th>\n      <th>PC121</th>\n      <th>PC122</th>\n      <th>PC123</th>\n      <th>PC124</th>\n      <th>PC125</th>\n      <th>PC126</th>\n      <th>PC127